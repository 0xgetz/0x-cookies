{
  "name": "nextdoor — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://nextdoor.com/news_feed/",
  "success": {
    "url_regex": "^https://nextdoor\\.com/(news_feed|feed)"
  },
  "fail": {
    "url_regex": "nextdoor\\.com/(login|signup|new)"
  },
  "captures": [],
  "retry": 1
}