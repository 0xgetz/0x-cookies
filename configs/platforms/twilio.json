{
  "name": "twilio — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://console.twilio.com/",
  "success": {
    "url_regex": "^https://console\\.twilio\\.com/"
  },
  "fail": {
    "url_regex": "twilio\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}