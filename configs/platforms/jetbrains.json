{
  "name": "jetbrains — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://account.jetbrains.com/",
  "success": {
    "url_regex": "^https://account\\.jetbrains\\.com/(licenses|profile|home)"
  },
  "fail": {
    "url_regex": "account\\.jetbrains\\.com/(login|signin|auth)"
  },
  "captures": [],
  "retry": 1
}