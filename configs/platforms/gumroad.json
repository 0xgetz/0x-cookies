{
  "name": "gumroad — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://gumroad.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?gumroad\\.com/"
  },
  "fail": {
    "url_regex": "gumroad\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}