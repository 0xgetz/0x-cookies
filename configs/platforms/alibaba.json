{
  "name": "alibaba — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.alibaba.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?alibaba\\.com/"
  },
  "fail": {
    "url_regex": "alibaba\\.com/(member/login|login)"
  },
  "captures": [],
  "retry": 1
}