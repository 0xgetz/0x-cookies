{
  "name": "monday — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://auth.monday.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?monday\\.com/(home|users|boards)"
  },
  "fail": {
    "url_regex": "auth\\.monday\\.com/(auth/login|users/sign_in)"
  },
  "captures": [],
  "retry": 1
}