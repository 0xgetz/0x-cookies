{
  "name": "allegro — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://allegro.pl/moje-konto",
  "success": {
    "url_regex": "^https://allegro\\.pl/(moje-konto|my-account)"
