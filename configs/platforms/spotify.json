{
  "name": "spotify — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://open.spotify.com/collection/albums",
  "success": {
    "url_regex": "^https://(open\\.)?spotify\\.com/"
  },
  "fail": {
    "url_regex": "accounts\\.spotify\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}