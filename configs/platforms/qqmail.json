{
  "name": "qqmail — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://mail.qq.com/",
  "success": {
    "url_regex": "^https://mail\\.qq\\.com/"
  },
  "fail": {
    "url_regex": "mail\\.qq\\.com/(cgi-bin/login|loginpage)"
  },
  "captures": [],
  "retry": 1
}