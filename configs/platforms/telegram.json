{
  "name": "telegram — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://web.telegram.org/a/",
  "success": {
    "url_regex": "^https://web\\.telegram\\.org/"
  },
  "fail": {
    "url_regex": "web\\.telegram\\.org/.*(?!/)"
  },
  "captures": [],
  "retry": 1
}