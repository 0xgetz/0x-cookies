{
  "name": "tradingview — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.tradingview.com/chart/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?tradingview\\.com/"
  },
  "fail": {
    "url_regex": "tradingview\\.com/(accounts/signin|accounts/signup)"
  },
  "captures": [],
  "retry": 1
}