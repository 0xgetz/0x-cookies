{
  "name": "datadog — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.datadoghq.com/",
  "success": {
    "url_regex": "^https://app\\.datadoghq\\.com/(dash|account|dashboard)"
  },
  "fail": {
    "url_regex": "(app|www)?\\.?datadoghq\\.com/(account/login|login)"
  },
  "captures": [],
  "retry": 1
}