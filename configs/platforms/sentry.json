{
  "name": "sentry — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://sentry.io/organizations/",
  "success": {
    "url_regex": "^https://sentry\\.io/(organizations|issues|settings)"
  },
  "fail": {
    "url_regex": "sentry\\.io/(auth/login|account/login)"
  },
  "captures": [],
  "retry": 1
}