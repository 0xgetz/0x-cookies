{
  "name": "tumblr — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.tumblr.com/dashboard",
  "success": {
    "url_regex": "^https://(www\\.)?tumblr\\.com/(dashboard|blog)"
  },
  "fail": {
    "url_regex": "tumblr\\.com/(login|register)"
  },
  "captures": [],
  "retry": 1
}