{
  "name": "airbnb — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.airbnb.com/hosting",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?airbnb\\.[\\w.]+/(hosting|account)"
  },
  "fail": {
    "url_regex": "airbnb\\.[\\w.]+/(login|signup)"
  },
  "captures": [],
  "retry": 1
}