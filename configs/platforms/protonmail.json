{
  "name": "protonmail — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://mail.proton.me/u/0/inbox",
  "success": {
    "url_regex": "^https://(mail\\.)?proton\\.(me|mail\\.com)/u/"
  },
  "fail": {
    "url_regex": "proton\\.(me|mail\\.com)/(login|signup|account)"
  },
  "captures": [],
  "retry": 1
}