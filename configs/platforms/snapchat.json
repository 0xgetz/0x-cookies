{
  "name": "snapchat — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://web.snapchat.com/",
  "success": {
    "url_regex": "^https://web\\.snapchat\\.com/"
  },
  "fail": {
    "url_regex": "accounts\\.snapchat\\.com/(?!/web)"
  },
  "captures": [],
  "retry": 1
}