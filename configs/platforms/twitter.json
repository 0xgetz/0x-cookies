{
  "name": "twitter — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://x.com/settings/profile",
  "success": {
    "url_regex": "^https://(x|twitter)\\.com/(settings|home|i/)"
  },
  "fail": {
    "url_regex": "(x|twitter)\\.com/(i/flow/login|login|i/flow/signup)",
    "body_regex": "Sign\\ in\\ to\\ X|Happening\\ now"
  },
  "captures": [],
  "retry": 1
}