{
  "name": "coursera — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.coursera.org/",
  "success": {
    "url_regex": "^https://(www\\.)?coursera\\.org/(?!.*login)"
  },
  "fail": {
    "url_regex": "coursera\\.org/(login|signup)"
  },
  "captures": [],
  "retry": 1
}