{
  "name": "hackernews — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://news.ycombinator.com/",
  "success": {
    "url_regex": "^https://news\\.ycombinator\\.com/(user|news)"
  },
  "fail": {
    "url_regex": "news\\.ycombinator\\.com/(login|forgot)"
  },
  "captures": [],
  "retry": 1
}