{
  "name": "bilibili — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.bilibili.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?bilibili\\.com/"
  },
  "fail": {
    "url_regex": "passport\\.bilibili\\.com/(login|register)",
    "body_regex": "登录|注册|Log\\ in"
  },
  "captures": [],
  "retry": 1
}