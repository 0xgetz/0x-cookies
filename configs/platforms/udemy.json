{
  "name": "udemy — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.udemy.com/home/my-courses/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?udemy\\.com/"
  },
  "fail": {
    "url_regex": "udemy\\.com/(join|login)"
  },
  "captures": [],
  "retry": 1
}