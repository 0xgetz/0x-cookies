{
  "name": "zhihu — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.zhihu.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?zhihu\\.com/(?!signin)"
  },
  "fail": {
    "url_regex": "zhihu\\.com/(signin|login)"
  },
  "captures": [],
  "retry": 1
}