{
  "name": "bluesky — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://bsky.app/settings",
  "success": {
    "url_regex": "^https://bsky\\.app/(settings|home|profile)"
  },
  "fail": {
    "url_regex": "bsky\\.app/(signin|signup)"
  },
  "captures": [],
  "retry": 1
}