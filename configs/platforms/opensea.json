{
  "name": "opensea — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://opensea.io/",
  "success": {
    "url_regex": "^https://opensea\\.io/(account|settings)"
  },
  "fail": {
    "url_regex": "opensea\\.io/(login|account/login)"
  },
  "captures": [],
  "retry": 1
}