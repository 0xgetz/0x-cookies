{
  "name": "replicate — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://replicate.com/account",
  "success": {
    "url_regex": "^https://replicate\\.com/(account|dashboard)"
  },
  "fail": {
    "url_regex": "replicate\\.com/(login|signin|auth)"
  },
  "captures": [],
  "retry": 1
}