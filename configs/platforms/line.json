{
  "name": "line — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://access.line.me/dialog/oauth/weblogin",
  "success": {
    "url_regex": "^https://(access\\.)?line\\.me/(?!/dialog)",
    "body_regex": "Talk|Timeline|Home"
  },
  "fail": {
    "url_regex": "access\\.line\\.me/(login|oauth)",
    "body_regex": "Log\\ in|Login|Email\\ address"
  },
  "captures": [],
  "retry": 1
}