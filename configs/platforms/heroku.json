{
  "name": "heroku — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://dashboard.heroku.com/apps",
  "success": {
    "url_regex": "^https://dashboard\\.heroku\\.com/"
  },
  "fail": {
    "url_regex": "(id\\.heroku\\.com/login|heroku\\.com/login)"
  },
  "captures": [],
  "retry": 1
}