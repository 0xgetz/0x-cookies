{
  "name": "perplexity — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.perplexity.ai/settings/account",
  "success": {
    "url_regex": "^https://(www\\.)?perplexity\\.ai/"
  },
  "fail": {
    "url_regex": "perplexity\\.ai/(login|auth)"
  },
  "captures": [],
  "retry": 1
}