{
  "name": "mailchimp — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://login.mailchimp.com/",
  "success": {
    "url_regex": "^https://([\\w.-]*\\.)?mailchimp\\.com/(?!/login)"
  },
  "fail": {
    "url_regex": "mailchimp\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}