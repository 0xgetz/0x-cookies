{
  "name": "trello — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://trello.com/",
  "success": {
    "url_regex": "^https://trello\\.com/(boards)"
  },
  "fail": {
    "url_regex": "trello\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}