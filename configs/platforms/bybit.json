{
  "name": "bybit — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.bybit.com/user/assets/home",
  "success": {
    "url_regex": "^https://(www\\.)?bybit\\.com/(user|assets)"
  },
