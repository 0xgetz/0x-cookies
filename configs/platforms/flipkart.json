{
  "name": "flipkart — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.flipkart.com/account/orders",
  "success": {
    "url_regex": "^https://(www\\.)?flipkart\\.com/account"
  },
