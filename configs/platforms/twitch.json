{
  "name": "twitch — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://dashboard.twitch.tv/",
  "success": {
    "url_regex": "^https://(dashboard|www)\\.twitch\\.tv/"
  },
  "fail": {
    "url_regex": "twitch\\.tv/(login|signup|downloads)"
  },
  "captures": [],
  "retry": 1
}