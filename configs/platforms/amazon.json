{
  "name": "amazon — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.amazon.com/gp/css/order-history",
  "success": {
    "url_regex": "^https://(www\\.)?amazon\\.[\\w.]+/(gp|your-account|orders)"
  },
  "fail": {
    "url_regex": "amazon\\.[\\w.]+/(ap/signin|gp/sign-in)"
  },
  "captures": [],
  "retry": 1
}