{
  "name": "naver — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://nid.naver.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?naver\\.com/"
  },
  "fail": {
    "url_regex": "nid\\.naver\\.com/(nidlogin|nidlogin/login)"
  },
  "captures": [],
  "retry": 1
}