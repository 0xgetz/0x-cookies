{
  "name": "atlassian — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://id.atlassian.com/manage-profile/profile-and-visibility",
  "success": {
    "url_regex": "^https://(id\\.)?atlassian\\.com/"
  },
  "fail": {
    "url_regex": "atlassian\\.com/(login|authorize)"
  },
  "captures": [],
  "retry": 1
}