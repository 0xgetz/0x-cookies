{
  "name": "gmx — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.gmx.com/",
  "success": {
    "url_regex": "^https://(www\\.)?gmx\\.[\\w.]+/"
  },
  "fail": {
    "url_regex": "gmx\\.[\\w.]+/(login|signin)"
  },
  "captures": [],
  "retry": 1
}