{
  "name": "instagram — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.instagram.com/accounts/edit/",
  "success": {
    "url_regex": "^https://(www\\.)?instagram\\.com/(accounts/edit|direct|explore)"
  },
  "fail": {
    "url_regex": "instagram\\.com/accounts/(login|emailsignup)",
    "body_regex": "Log\\ in|Sign\\ up"
  },
  "captures": [],
  "retry": 1
}