{
  "name": "circleci — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.circleci.com/",
  "success": {
    "url_regex": "^https://app\\.circleci\\.com/(pipelines|home)"
  },
  "fail": {
    "url_regex": "circleci\\.com/(login|signup|signup)"
  },
  "captures": [],
  "retry": 1
}