{
  "name": "airtable — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://airtable.com/",
  "success": {
    "url_regex": "^https://airtable\\.com/(?!/login)"
  },
  "fail": {
    "url_regex": "airtable\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}