{
  "name": "replit — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://replit.com/~",
  "success": {
    "url_regex": "^https://replit\\.com/(~|@)"
  },
  "fail": {
    "url_regex": "replit\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}