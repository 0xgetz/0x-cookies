{
  "name": "wordpress — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://wordpress.com/",
  "success": {
    "url_regex": "^https://(www\\.)?wordpress\\.com/(home|reader|me)"
  },
  "fail": {
    "url_regex": "wordpress\\.com/(log-in|start)"
  },
  "captures": [],
  "retry": 1
}