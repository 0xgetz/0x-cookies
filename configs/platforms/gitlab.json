{
  "name": "gitlab — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://gitlab.com/dashboard/projects",
  "success": {
    "url_regex": "^https://gitlab\\.com/"
  },
  "fail": {
    "url_regex": "gitlab\\.com/(users/sign_in|users/sign_up)"
  },
  "captures": [],
  "retry": 1
}