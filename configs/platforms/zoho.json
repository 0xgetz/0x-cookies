{
  "name": "zoho — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://mail.zoho.com/zm/",
  "success": {
    "url_regex": "^https://(mail|accounts|www)\\.zoho\\.[\\w.]+/"
  },
  "fail": {
    "url_regex": "zoho\\.[\\w.]+/(signin|login)"
  },
  "captures": [],
  "retry": 1
}