{
  "name": "asana — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.asana.com/",
  "success": {
    "url_regex": "^https://app\\.asana\\.com/"
  },
  "fail": {
    "url_regex": "asana\\.com/(-/login|login|signup)"
  },
  "captures": [],
  "retry": 1
}