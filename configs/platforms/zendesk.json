{
  "name": "zendesk — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.zendesk.com/",
  "success": {
    "url_regex": "^https://([\\w.-]*\\.)?zendesk\\.com/"
  },
  "fail": {
    "url_regex": "zendesk\\.com/(login|signin|registration)"
  },
  "captures": [],
  "retry": 1
}