{
  "name": "dailymotion — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.dailymotion.com/settings",
  "success": {
    "url_regex": "^https://(www\\.)?dailymotion\\.com/"
  },
  "fail": {
    "url_regex": "dailymotion\\.com/(login|signin|signup)"
  },
  "captures": [],
  "retry": 1
}