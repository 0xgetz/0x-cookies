{
  "name": "flickr — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.flickr.com/photos/me",
  "success": {
    "url_regex": "^https://(www\\.)?flickr\\.com/(photos|settings)"
  },
  "fail": {
    "url_regex": "flickr\\.com/(signin|login)|identity\\.flickr\\.com"
  },
  "captures": [],
  "retry": 1
}