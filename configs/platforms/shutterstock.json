{
  "name": "shutterstock — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.shutterstock.com/",
  "success": {
    "url_regex": "^https://(www\\.)?shutterstock\\.com/"
  },
  "fail": {
    "url_regex": "shutterstock\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}