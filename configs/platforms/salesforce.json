{
  "name": "salesforce — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://login.salesforce.com/",
  "success": {
    "url_regex": "^https://([\\w.-]*\\.)?salesforce\\.com/(home|lightning)"
  },
  "fail": {
    "url_regex": "salesforce\\.com/(login|secur/login)"
  },
  "captures": [],
  "retry": 1
}