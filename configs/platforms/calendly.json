{
  "name": "calendly — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://calendly.com/event_types/user/me",
  "success": {
    "url_regex": "^https://calendly\\.com/(app|event_types)"
  },
  "fail": {
    "url_regex": "calendly\\.com/(login|signup|app/login)"
  },
  "captures": [],
  "retry": 1
}