{
  "name": "cloudflare — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://dash.cloudflare.com/",
  "success": {
    "url_regex": "^https://dash\\.cloudflare\\.com/"
  },
  "fail": {
    "url_regex": "cloudflare\\.com/(login|sign-up)"
  },
  "captures": [],
  "retry": 1
}