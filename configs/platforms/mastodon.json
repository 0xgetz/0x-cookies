{
  "name": "mastodon — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://mastodon.social/home",
  "success": {
    "url_regex": "^https://([\\w.-]*\\.)?mastodon\\.social/"
  },
  "fail": {
    "url_regex": "mastodon\\.social/(auth/sign_in|explore|about)"
  },
  "captures": [],
  "retry": 1
}