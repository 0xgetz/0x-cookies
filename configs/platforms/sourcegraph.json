{
  "name": "sourcegraph — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://sourcegraph.com/search",
  "success": {
    "url_regex": "^https://sourcegraph\\.com/(search|settings)"
  },
  "fail": {
    "url_regex": "sourcegraph\\.com/(sign-in|signin|login)"
  },
  "captures": [],
  "retry": 1
}