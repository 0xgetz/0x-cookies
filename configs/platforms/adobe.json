{
  "name": "adobe — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://account.adobe.com/",
  "success": {
    "url_regex": "^https://account\\.adobe\\.com/(?!.*signin)"
  },
  "fail": {
    "url_regex": "account\\.adobe\\.com/(signin|login)",
    "body_regex": "Sign\\ in|Create\\ an\\ account|Sign\\ in\\ to\\ your\\ account"
  },
  "captures": [],
  "retry": 1
}