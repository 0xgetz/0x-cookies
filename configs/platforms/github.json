{
  "name": "github — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://github.com/settings/profile",
  "success": {
    "url_regex": "^https://github\\.com/(settings|dashboard)"
  },
  "fail": {
    "url_regex": "github\\.com/(login|signup|session)"
  },
  "captures": [],
  "retry": 1
}