{
  "name": "hubspot — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.hubspot.com/",
  "success": {
    "url_regex": "^https://app\\.hubspot\\.com/(reports-dashboard|home)"
  },
  "fail": {
    "url_regex": "app\\.hubspot\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}