{
  "name": "stackoverflow — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://stackoverflow.com/users/edit/current",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?stackoverflow\\.com/users"
  },
  "fail": {
    "url_regex": "stackoverflow\\.com/users/(login|signup)"
  },
  "captures": [],
  "retry": 1
}