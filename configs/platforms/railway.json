{
  "name": "railway — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://railway.app/dashboard",
  "success": {
    "url_regex": "^https://railway\\.(app|com)/"
  },
  "fail": {
    "url_regex": "railway\\.(app|com)/(login|signup)"
  },
  "captures": [],
  "retry": 1
}