{
  "name": "netlify — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.netlify.com/",
  "success": {
    "url_regex": "^https://app\\.netlify\\.com/"
  },
  "fail": {
    "url_regex": "netlify\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}