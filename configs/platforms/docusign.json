{
  "name": "docusign — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.docusign.com/documents",
  "success": {
    "url_regex": "^https://app\\.docusign\\.com/"
  },
  "fail": {
    "url_regex": "app(ds)?\\.docusign\\.com/(authentication|login)|account\\.docusign\\.com"
  },
  "captures": [],
  "retry": 1
}