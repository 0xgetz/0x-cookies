{
  "name": "fastmail — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://app.fastmail.com/mail/Inbox",
  "success": {
    "url_regex": "^https://app\\.fastmail\\.com/"
  },
  "fail": {
    "url_regex": "fastmail\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}