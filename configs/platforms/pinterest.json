{
  "name": "pinterest — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.pinterest.com/settings/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?pinterest\\.com/(settings)"
  },
  "fail": {
    "url_regex": "pinterest\\.com/(login|signup)"
  },
  "captures": [],
  "retry": 1
}