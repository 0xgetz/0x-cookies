{
  "name": "rakuten — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://www.rakuten.com/",
  "success": {
    "url_regex": "^https://(www\\.)?rakuten\\.com/(account|my-account)"
  },
  "fail": {
    "url_regex": "rakuten\\.com/(login|signin|register)"
  },
  "captures": [],
  "retry": 1
}