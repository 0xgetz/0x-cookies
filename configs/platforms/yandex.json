{
  "name": "yandex — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://mail.yandex.com/",
  "success": {
    "url_regex": "^https://([\\w.]*\\.)?yandex\\.[\\w.]+/"
  },
  "fail": {
    "url_regex": "passport\\.yandex\\.[\\w.]+/(auth|login)"
  },
  "captures": [],
  "retry": 1
}