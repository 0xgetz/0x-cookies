{
  "name": "zoom — cookie/session check",
  "author": "0x Cookies",
  "type": "browser",
  "input_format": "line",
  "url": "https://us05web.zoom.us/profile",
  "success": {
    "url_regex": "^https://[\\w.-]*zoom\\.us/(profile|meeting|web)"
  },
  "fail": {
    "url_regex": "zoom\\.us/(signin|login)"
  },
  "captures": [],
  "retry": 1
}